<?xml version="1.0" encoding="UTF-8"?>
<!--
  HB-REM-VIVALDI — Steven Schmitt's La Spaziale Vivaldi II Espresso-Remote.

  Zwei SWITCH-Channels — einer pro Vivaldi-Funktion (Power + Boiler).
  Jeder Channel ist im Gerät an einen Taster-Output (PA0/PA1) und an einen
  LED-Input (PB10/PB11) gekoppelt. STATE spiegelt den realen Maschinen-Zustand
  (aus der LED gelesen); ein SET vom CCU löst genau einen Taster-Puls aus.

  Peering ist deaktiviert (Firmware: PEERS_PER_CHANNEL=0). Bedienung
  ausschließlich via CCU-WebUI/Programme.

  XML-FW-Abgleich 2026-08-09 (Audit XF-01..XF-11): Alle Deklarationen ohne
  Firmware-Gegenstück entfernt — ON_TIME (FW ignorierte die Einschaltdauer:
  Maschine wäre nie ausgegangen), INSTALL_TEST (Zuordnungstest = realer
  Tasterpuls an der Maschine), TRANSMIT_DEV_TRY_MAX + INTERNAL_KEYS_VISIBLE
  (Legacy-List0 der FW kennt die Register nicht bzw. niemand liest sie),
  STATUSINFO_MINDELAY/RANDOM (kein FW-Konsument, Status kommt designbedingt
  sofort), INFO_POWERON (FW sendet nie Kanal 0), updatable=false (kein
  OTA-Bootloader auf STM32). cyclic_timeout=3600 bleibt — FW ab V1.1 bedient
  es mit einem 600-s-Heartbeat (bis zum V1.1-Flash läuft auf dem Board V1.0,
  die UNREACH-Meldungen enden erst mit dem Flash, nicht mit diesem XML). -->
<device version="1" cyclic_timeout="3600" supports_aes="false">
  <supported_types>
    <type name="HB-REM-VIVALDI" id="HB-REM-VIVALDI" priority="2" updatable="false">
      <parameter index="10.0" size="2.0" const_value="0xF400" />
    </type>
  </supported_types>
  <paramset type="MASTER" id="hb_rem_vivaldi_dev_master" />
  <channels>
    <channel index="0" type="MAINTENANCE" ui_flags="internal" class="maintenance" count="1">
      <paramset type="MASTER" id="maint_ch_master" />
      <paramset type="VALUES" id="maint_ch_values">
        <parameter id="UNREACH" operations="read,event" ui_flags="service">
          <logical type="boolean" />
          <physical type="integer" interface="internal" value_id="UNREACH" />
        </parameter>
        <parameter id="STICKY_UNREACH" operations="read,write,event" ui_flags="service,sticky">
          <logical type="boolean" />
          <physical type="integer" interface="internal" value_id="STICKY_UNREACH" />
        </parameter>
        <parameter id="CONFIG_PENDING" operations="read,event" ui_flags="service">
          <logical type="boolean" />
          <physical type="integer" interface="internal" value_id="CONFIG_PENDING" />
        </parameter>
        <parameter id="RSSI_DEVICE" operations="read,event">
          <logical type="integer" />
          <physical type="integer" interface="internal" value_id="RSSI_DEVICE" />
        </parameter>
        <parameter id="RSSI_PEER" operations="read,event">
          <logical type="integer" />
          <physical type="integer" interface="internal" value_id="RSSI_PEER" />
        </parameter>
        <parameter id="DEVICE_IN_BOOTLOADER" operations="read,event" ui_flags="service">
          <logical type="boolean" />
          <physical type="integer" interface="internal" value_id="DEVICE_IN_BOOTLOADER" />
        </parameter>
        <parameter id="UPDATE_PENDING" operations="read,event" ui_flags="service">
          <logical type="boolean" />
          <physical type="integer" interface="internal" value_id="UPDATE_PENDING" />
        </parameter>
      </paramset>
    </channel>

    <!-- Channel 1: Power. STATE = Maschinen-Zustand (aus LED), SET = Taster-Puls.
         Peering deaktiviert (leere link_roles + LINK), passt zu Firmware PEERS_PER_CHANNEL=0. -->
    <channel index="1" type="SWITCH" count="1">
      <link_roles></link_roles>
      <paramset type="MASTER" id="switch_ch_master_1">
        <subset ref="switch_paramset"/>
      </paramset>
      <paramset type="VALUES" id="switch_ch_values_1">
        <subset ref="switch_valueset"/>
      </paramset>
      <paramset type="LINK" id="switch_ch_link_1"></paramset>
    </channel>

    <!-- Channel 2: Boiler. Selbes Schema wie Channel 1. -->
    <channel index="2" type="SWITCH" count="1">
      <link_roles></link_roles>
      <paramset type="MASTER" id="switch_ch_master_2">
        <subset ref="switch_paramset"/>
      </paramset>
      <paramset type="VALUES" id="switch_ch_values_2">
        <subset ref="switch_valueset"/>
      </paramset>
      <paramset type="LINK" id="switch_ch_link_2"></paramset>
    </channel>
  </channels>

  <frames>
    <frame id="LEVEL_SET" direction="to_device" type="0x11" subtype="0x02" subtype_index="9" channel_field="10">
      <parameter type="integer" index="11.0" size="1.0" param="STATE"/>
      <parameter type="integer" index="12.0" size="2.0" const_value="0"/>
    </frame>
    <frame id="LEVEL_GET" direction="to_device" type="0x01" channel_field="9">
      <parameter type="integer" index="10.0" size="1.0" const_value="14"/>
    </frame>
    <frame id="INFO_LEVEL" direction="from_device" allowed_receivers="BROADCAST,CENTRAL,OTHER" event="true" type="0x10" subtype="6" subtype_index="9" channel_field="10">
      <parameter type="integer" index="11.0" size="1.0" param="STATE"/>
      <parameter type="integer" index="12.4" size="0.3" param="STATE_FLAGS"/>
    </frame>
    <frame id="ACK_STATUS" direction="from_device" allowed_receivers="BROADCAST,CENTRAL,OTHER" event="true" type="0x02" subtype="1" subtype_index="9" channel_field="10">
      <parameter type="integer" index="11.0" size="1.0" param="STATE"/>
      <parameter type="integer" index="12.4" size="0.3" param="STATE_FLAGS"/>
    </frame>
  </frames>

  <paramset_defs>
    <paramset id="switch_valueset">
      <parameter id="STATE" operations="read,write,event" control="SWITCH.STATE">
        <logical type="boolean" default="false"/>
        <physical type="integer" interface="command" value_id="STATE">
          <set request="LEVEL_SET"/>
          <get request="LEVEL_GET" response="INFO_LEVEL" process_as_event="true"/>
          <event frame="INFO_LEVEL" auth_violate_policy="get"/>
          <event frame="ACK_STATUS" auth_violate_policy="get"/>
        </physical>
        <conversion type="boolean_integer" threshold="1" false="0" true="200"/>
      </parameter>
      <parameter id="WORKING" operations="read,event" ui_flags="internal">
        <logical type="boolean" default="false"/>
        <physical type="integer" interface="command" value_id="STATE_FLAGS">
          <get request="LEVEL_GET" response="INFO_LEVEL" process_as_event="true"/>
          <event frame="INFO_LEVEL"/>
          <event frame="ACK_STATUS"/>
        </physical>
        <conversion type="boolean_integer"/>
      </parameter>
    </paramset>

    <paramset id="switch_paramset">
      <parameter id="AES_ACTIVE" ui_flags="internal">
        <logical type="boolean" default="false"/>
        <physical type="boolean" interface="internal" value_id="AES"/>
      </parameter>
    </paramset>
  </paramset_defs>
</device>
